# ── Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos (Neon: usa la cadena "pooled") ─────────────────────────────
DATABASE_URL=postgresql://griselle:griselle_secret@localhost:5432/griselle_db?schema=public

# ── Autenticación ─────────────────────────────────────────────────────────
# Genera uno nuevo para producción: openssl rand -base64 48
JWT_SECRET=change_me_in_production_use_a_256bit_random_key
JWT_EXPIRES_IN=7d

LOG_LEVEL=debug

# Uno o más orígenes separados por coma (sin espacio ni barra final)
CORS_ORIGIN=http://localhost:5173

# URL pública única del frontend, para armar links en correos (confirmación de
# cuenta, reseteo de contraseña). En producción: https://app.aerocamo.cl
APP_URL=http://localhost:5173

# ── Correo ────────────────────────────────────────────────────────────────
# Sin SMTP_HOST configurado, el envío de la ST por correo se rechaza con un
# aviso claro; el resto de la plataforma funciona igual.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@aerocamo.cl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Alternativa a SMTP si EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# ── WhatsApp Business (Meta Cloud API) — opcional ────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=nueva_solicitud_trabajo
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_DEFAULT_COUNTRY_CODE=56

# ── AWS S3 (evidencias de OT) — opcional ─────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
