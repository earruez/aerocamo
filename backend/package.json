{
  "name": "griselle-api",
  "version": "1.0.0",
  "description": "Aeronautical Maintenance SaaS — Backend API",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint 'src/**/*.ts' --fix",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:integration:eligibility": "RUN_DB_INTEGRATION_TESTS=1 jest --runInBand src/test/executionEligibility.integration.test.ts",
    "test:integration:phase7-master-counter": "RUN_DB_INTEGRATION_TESTS=1 jest --runInBand src/test/phase7MasterCounter.integration.test.ts",
    "test:integration:phase8-assigned-plans": "RUN_DB_INTEGRATION_TESTS=1 jest --runInBand src/test/phase8AssignedPlans.integration.test.ts",
    "test:integration:due-engine": "RUN_DB_INTEGRATION_TESTS=1 jest --runInBand src/test/dueEngine.integration.test.ts",
    "seed": "tsx prisma/seed.ts",
    "import:access:csv": "tsx prisma/import_access_csv.ts",
    "cleanup:org:test-data": "tsx prisma/cleanup_org_test_data.ts",
    "cleanup:org:test-data:dry-run": "tsx prisma/cleanup_org_test_data.ts --dry-run",
    "backfill:component-tracking": "tsx src/scripts/backfillComponentTracking.ts",
    "verify:component-tracking-backfill": "tsx src/scripts/verifyComponentTrackingBackfill.ts",
    "import:template:xlsx": "tsx prisma/import_maintenance_template_xlsx.ts",
    "import:template:regulatory": "tsx prisma/create_regulatory_templates.ts",
    "transform:access:csv:v2": "tsx prisma/transform_access_csv_v2.ts",
    "report:ot:task-mapping-pending": "tsx prisma/report_ot_task_mapping_pending.ts",
    "report:ot:maintenance-task-match": "tsx prisma/report_ot_maintenance_task_match.ts",
    "report:ot:maintenance-task-candidates": "tsx prisma/report_ot_maintenance_task_candidates.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:apply:aircraft-usage-history": "prisma db execute --schema prisma/schema.prisma --file prisma/manual_migrations/20260415_aircraft_usage_history.sql",
    "prisma:apply:work-request-item-execution-metadata": "prisma db execute --schema prisma/schema.prisma --file prisma/manual_migrations/20260416_work_request_item_execution_metadata.sql",
    "prisma:apply:work-request-item-traceability-metadata": "prisma db execute --schema prisma/schema.prisma --file prisma/manual_migrations/20260420_work_request_item_traceability_metadata.sql",
    "prisma:apply:component-tracking-backend-model": "prisma db execute --schema prisma/schema.prisma --file prisma/manual_migrations/20260420_component_tracking_backend_model.sql",
    "prisma:apply:aircraft-assigned-plan": "prisma db execute --schema prisma/schema.prisma --file prisma/manual_migrations/20260420_aircraft_assigned_plan.sql",
    "prisma:apply:aircraft-engine-tracking": "prisma db execute --schema prisma/schema.prisma --file prisma/manual_migrations/20260424_aircraft_engine_tracking.sql",
    "prisma:apply:maintenance-task-equipment-scope": "prisma db execute --schema prisma/schema.prisma --file prisma/manual_migrations/20260806_maintenance_task_equipment_scope.sql"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1029.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.14.0",
    "pino": "^9.2.0",
    "pino-http": "^10.1.0",
    "pino-pretty": "^11.2.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.2",
    "@types/nodemailer": "^6.4.23",
    "@types/pdfkit": "^0.17.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  }
}
