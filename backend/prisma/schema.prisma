// ═════════════════════════════════════════════════════════════════════════════
//  Griselle — Aeronautical Maintenance SaaS
//  Prisma Schema  ·  Professional Data Model
// ═════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────────

/// Subscription tiers for the SaaS model
enum SubscriptionPlan {
  FREE
  PROFESSIONAL
  ENTERPRISE

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
  SUSPENDED

  @@map("subscription_status")
}

/// Aeronautical operational status — AOG is a critical blocking state
enum AircraftStatus {
  OPERATIONAL       // Available for flight
  AOG               // Aircraft On Ground — grounded due to defect
  IN_MAINTENANCE    // Planned maintenance check in progress
  GROUNDED          // Administratively grounded (e.g., expired cert)
  DECOMMISSIONED    // Permanently withdrawn from service

  @@map("aircraft_status")
}

enum AircraftEnginePosition {
  N1
  N2

  @@map("aircraft_engine_position")
}

  enum AircraftUsageSource {
    manual
    flight_log
    ot_close
    import
    baseline

    @@map("aircraft_usage_source")
  }
enum ComponentStatus {
  INSTALLED         // Currently fitted to an aircraft
  SERVICEABLE       // In store, ready for installation
  UNSERVICEABLE     // Removed and awaiting shop action
  IN_SHOP           // Under repair/overhaul at a MRO
  SCRAPPED          // Beyond economic repair, disposed

  @@map("component_status")
}

/// Interval type driving a maintenance task's recurrence
enum TaskIntervalType {
  FLIGHT_HOURS      // e.g. every 100 flight hours
  CYCLES            // e.g. every 500 landings
  CALENDAR_DAYS     // e.g. every 365 days
  FLIGHT_HOURS_OR_CALENDAR // whichever comes first
  CYCLES_OR_CALENDAR
  ON_CONDITION      // Condition-monitored, no fixed interval

  @@map("task_interval_type")
}

/// Regulatory/technical reference classification
enum ReferenceType {
  AMM               // Aircraft Maintenance Manual
  AD                // Airworthiness Directive (mandatory)
  SB                // Service Bulletin (manufacturer)
  CMR               // Certification Maintenance Requirement
  CDCCL             // Critical Design Configuration Control Limitation
  MPD               // Maintenance Planning Document
  ETOPS             // Extended Operations requirement
  INTERNAL          // Operator-defined task

  @@map("reference_type")
}

enum ComplianceStatus {
  COMPLETED
  DEFERRED          // Officially deferred with MEL/NEF reference
  OVERDUE           // Past due date/hours — requires immediate attention
  CANCELLED

  @@map("compliance_status")
}

enum ComplianceRecurrence {
  REPETITIVE        // Vuelve a vencer tras cumplirse (Access REP)
  ONE_TIME          // Cumplimiento único (Access UNA VEZ / UNICA VEZ)
  ON_CONDITION      // Según condición (Access COND / A REQ.)
  ON_EVENT          // Ante un evento (Access AL EVENTO)
  PERMANENT         // Permanente / abierta (Access PERM / OPEN)
  UNSPECIFIED       // Sin recurrencia declarada en el origen

  @@map("compliance_recurrence")
}

enum EquipmentScope {
  AIRCRAFT          // Célula / estructura de la aeronave
  ENGINE            // Motor y sus accesorios

  @@map("equipment_scope")
}

/// Equipos que la DGAC numera en su lista de presentación (puntos IV.2.x,
/// IV.3.x y IV.4.x). No es lo mismo que EquipmentScope: aquel clasifica la
/// tarea (célula o motor), este identifica el equipo del que se presenta un
/// estatus por separado.
enum DgacEquipment {
  AERONAVE
  MOTOR_1
  MOTOR_2
  HELICE_1
  HELICE_2
  APU

  @@map("dgac_equipment")
}

enum ComplianceApplicationType {
  baseline
  application
  replacement_start

  @@map("compliance_application_type")
}

/// Work order lifecycle — transitions enforced by WorkOrderService
enum WorkOrderStatus {
  DRAFT         // Borrador — being assembled, not yet executable
  OPEN          // Abierta — approved, ready to execute
  IN_PROGRESS   // En ejecución — work has started
  QUALITY       // En calidad — awaiting independent inspector sign-off
  CLOSED        // Cerrada — inspector approved and signed off

  @@map("work_order_status")
}

/// Work order assignment lifecycle — tracks technician assignment and evidence
enum WorkOrderAssignmentStatus {
  PENDING              // Esperando asignación de técnico
  ASSIGNED             // Técnico asignado, pendiente de ejecución
  IN_PROGRESS          // En ejecución por técnico
  AWAITING_EVIDENCE    // Ejecución completada, esperando foto/PDF
  EVIDENCE_UPLOADED    // Fotografía/PDF recibida
  CLOSED               // OT cerrada y finalizada

  @@map("work_order_assignment_status")
}

/// Type of evidence file attached to work order
enum WorkOrderEvidenceType {
  PHOTO     // Fotografía digital del trabajo firmado
  PDF       // Documento PDF firmado digitalmente
  BOTH      // Foto y PDF adjuntos

  @@map("work_order_evidence_type")
}

/// Work request (Solicitud de Trabajo / ST) lifecycle
enum WorkRequestStatus {
  DRAFT       // Borrador editable
  IN_REVIEW   // En revisión antes de salir
  SENT        // Enviada al taller
  OT_RECEIVED // El taller devolvió la OT
  CLOSED      // Cerrada con cumplimientos registrados
  CANCELLED   // Cancelada

  @@map("work_request_status")
}

enum WorkRequestItemCategory {
  MAINTENANCE_PLAN
  NORMATIVE
  COMPONENT_INSPECTION
  DISCREPANCY
  OTHER

  @@map("work_request_item_category")
}

enum WorkRequestItemSourceKind {
  maintenance_plan
  component_inspection
  discrepancy
  compliance_due
  manual

  @@map("work_request_item_source_kind")
}

enum WorkRequestItemExecutionType {
  maintenance_application
  component_replacement
  discrepancy_action

  @@map("work_request_item_execution_type")
}

enum AssignedPlanCategory {
  manufacturer
  national_dgac
  engine_components
  origin_country

  @@map("assigned_plan_category")
}

enum DiscrepancyStatus {
  OPEN          // Hallazgo abierto, pendiente de acción
  DEFERRED      // Diferido con referencia MEL/CDL
  RESOLVED      // Resuelto, trabajo completado
  CANCELLED     // Cancelado (error de registro, etc.)

  @@map("discrepancy_status")
}

enum ComponentMovementType {
  INSTALLED     // Componente instalado en aeronave
  REMOVED       // Componente removido de aeronave

  @@map("component_movement_type")
}

enum ComponentIntervalType {
  hours
  cycles
  calendar
  mixed

  @@map("component_interval_type")
}

enum ComponentExecutionType {
  maintenance
  component_replacement

  @@map("component_execution_type")
}

enum ComponentInstanceStatus {
  installed
  removed
  spare
  scrapped

  @@map("component_instance_status")
}

enum ComponentMovementKind {
  install
  remove
  replacement

  @@map("component_movement_kind")
}

enum UserRole {
  ADMIN             // Full access, user management
  SUPERVISOR        // Approve work orders, sign-off compliances
  TECHNICIAN        // Perform and record maintenance work
  INSPECTOR         // Independent inspection sign-off (RII)
  READONLY          // View-only (auditors, clients)
  /// Platform-level: creates organizations and their users. Never scoped to a
  /// customer tenant; lives in an internal platform organization.
  SUPER_ADMIN

  @@map("user_role")
}

// ─────────────────────────────────────────────────────────────────────────────
//  ORGANIZATION  (Multi-tenant root)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  name               String             @db.VarChar(255)
  slug               String             @unique @db.VarChar(100)
  legalName          String?            @db.VarChar(255)
  /// Logo en PNG/JPEG como data URI (data:image/png;base64,...) — se
  /// incrusta directo en los PDF generados sin depender de un fetch externo.
  logoDataUri        String?            @db.Text
  country            String             @db.Char(2)          // ISO 3166-1 alpha-2
  subscriptionPlan   SubscriptionPlan   @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  subscriptionExpiresAt DateTime?
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  users              User[]
  aircraft           Aircraft[]
  aircraftAlterations AircraftAlteration[]
  aircraftTaskNotes   AircraftTaskNote[]
  aircraftStatusChanges AircraftStatusChange[]
  counterTypes          CounterType[]
  counterReadings       CounterReading[]
  taskCounterLimits     TaskCounterLimit[]
  equipmentCounterSlots EquipmentCounterSlot[]
  maintenanceManuals  MaintenanceManual[]
  repairShops         RepairShop[]
  repairShopContacts  RepairShopContact[]
  components         Component[]
  maintenanceTasks   MaintenanceTask[]
  compliances        Compliance[]
  workOrders         WorkOrder[]
  workRequests       WorkRequest[]
  discrepancies      Discrepancy[]
  maintenanceTemplates MaintenanceTemplate[]
  aircraftUsageLogs  AircraftUsageLog[]
  aircraftEngines    AircraftEngine[]
  aircraftEngineUsageLogs AircraftEngineUsageLog[]
  equipmentApplicability  AircraftEquipmentApplicability[]
  componentDefinitions ComponentDefinition[]
  componentInstances   ComponentInstance[]
  componentApplications ComponentApplication[]
  componentMovements   ComponentMovement[]
  aircraftAssignedPlans AircraftAssignedPlan[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
//  USERS  (Tenant-scoped, with aeronautical roles)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  email          String   @db.VarChar(255)
  name           String   @db.VarChar(255)
  passwordHash   String
  role           UserRole @default(TECHNICIAN)

  /// Aircraft Maintenance Engineer licence number (EASA Part-66, FAA A&P, etc.)
  licenseNumber  String?  @db.VarChar(50)
  licenseExpiry  DateTime?

  /// Authorization codes for specific maintenance tasks (e.g., engine run-up)
  certifications String[] @default([])
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Momento en que el usuario confirmó su cuenta (definió su propia contraseña
  /// vía el link del correo de bienvenida). Null = cuenta nunca confirmada.
  emailConfirmedAt       DateTime?
  /// Hash sha256 del token de reseteo/activación pendiente — nunca el token crudo.
  passwordResetTokenHash String?   @db.VarChar(64)
  passwordResetExpiresAt DateTime?

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Compliances the user performed (technician sign-off)
  compliancesPerformed  Compliance[]    @relation("PerformedBy")
  /// Compliances the user inspected (inspector independent sign-off)
  compliancesInspected  Compliance[]    @relation("InspectedBy")

  workOrdersCreated        WorkOrder[]    @relation("WOCreatedBy")
  workOrdersAssignedTechnician WorkOrder[] @relation("WOAssignedTechnician")
  workOrdersInspecting     WorkOrder[]    @relation("WOInspector")
  workOrdersClosed         WorkOrder[]    @relation("WOClosedBy")
  workOrdersEvidenceUploaded WorkOrder[]   @relation("WOEvidenceUploadedBy")
  workOrderTasksCompleted  WorkOrderTask[] @relation("WOTaskCompletedBy")
  workRequestsCreated      WorkRequest[]   @relation("WRCreatedBy")
  workRequestsResponsible  WorkRequest[]   @relation("WRResponsible")
  workRequestsSentBy       WorkRequest[]   @relation("WRSentBy")
  discrepanciesFound       Discrepancy[]  @relation("DiscrepancyFoundBy")
  discrepanciesResolved    Discrepancy[]  @relation("DiscrepancyResolvedBy")
  componentMovements       ComponentHistory[] @relation("ComponentMovedBy")
  componentTrackingMovements ComponentMovement[] @relation("ComponentTrackingMovedBy")
  aircraftTaskApplicabilityChanges AircraftTask[] @relation("AircraftTaskApplicability")
  equipmentApplicabilityChanges    AircraftEquipmentApplicability[]
  createdAlterations               AircraftAlteration[]
  createdTaskNotes                 AircraftTaskNote[]
  aircraftStatusChanges            AircraftStatusChange[]
  counterReadings                  CounterReading[]
  createdManuals                   MaintenanceManual[]
  createdRepairShops               RepairShop[]
  reviewedWorkRequests             WorkRequest[] @relation("WRReviewer")
  otRegisteredWorkRequests         WorkRequest[] @relation("WROtRegisteredBy")
  closedWorkRequests               WorkRequest[] @relation("WRClosedBy")
  assignedPlans            AircraftAssignedPlan[]

  @@unique([email, organizationId])
  @@index([organizationId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
//  AIRCRAFT  (MAT = Matrícula, primary registration identifier)
// ─────────────────────────────────────────────────────────────────────────────

model Aircraft {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @db.Uuid

  /// Registration mark (MAT) — unique within the organization, used as PK reference in operations
  registration       String        @db.VarChar(20)             // e.g. XA-GRI, EC-MJF

  model              String        @db.VarChar(150)            // e.g. Boeing 737-800
  manufacturer       String        @db.VarChar(150)            // e.g. Boeing
  serialNumber       String        @db.VarChar(100)            // Manufacturer's serial number (MSN)
  engineCount        Int           @default(2)

  /// Engine model for combined airframe+engine task applicability
  engineModel        String?       @db.VarChar(100)

  /// Accumulated flight hours since new (Hobbs / Airframe Total Time)
  totalFlightHours   Decimal       @default(0) @db.Decimal(10, 2)

  /// Landings / pressurisation cycles since new
  totalCycles        Int           @default(0)

  /// Current status — AOG triggers alerts across all open orders
  status             AircraftStatus @default(OPERATIONAL)

  /// Propietario registrado de la aeronave
  owner              String?       @db.VarChar(180)
  /// Año de fabricación. El Access solo guarda el año, no la fecha completa.
  yearManufactured   Int?          @db.SmallInt
  manufactureDate    DateTime?     @db.Date
  registrationDate   DateTime?     @db.Date

  /// Certificate of Airworthiness expiry
  coaExpiryDate      DateTime?     @db.Date

  /// Insurance expiry date
  insuranceExpiryDate DateTime?    @db.Date

  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  components         Component[]

  /// M:N — which maintenance tasks apply to this aircraft
  applicableTasks    AircraftTask[]
  compliances        Compliance[]
  workOrders         WorkOrder[]
  workRequests       WorkRequest[]
  componentHistory   ComponentHistory[]
  usageLogs          AircraftUsageLog[]
  alterations        AircraftAlteration[]
  statusChanges      AircraftStatusChange[]
  counterReadings    CounterReading[]
  counterSlots       EquipmentCounterSlot[]
  taskNotes          AircraftTaskNote[]
  engines            AircraftEngine[]
  componentInstances ComponentInstance[]
  componentApplications ComponentApplication[]
  componentMovements ComponentMovement[]
  assignedPlans      AircraftAssignedPlan[]
  equipmentApplicability AircraftEquipmentApplicability[]

  // Indexes for common lookups
  @@unique([registration, organizationId])
  @@index([organizationId])
  @@index([registration])                    // fast search by MAT
  @@index([status, organizationId])          // AOG dashboard queries
  @@map("aircraft")
}

model AircraftEngine {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  aircraftId     String                @db.Uuid
  position       AircraftEnginePosition
  manufacturer   String                @db.VarChar(150)
  model          String                @db.VarChar(150)
  serialNumber   String                @db.VarChar(100)
  /// false = motor retirado (reemplazado por otro). Su historial de horas/
  /// ciclos y lecturas se conserva intacto, solo deja de ser el motor
  /// "actual" de esa posición.
  isActive       Boolean               @default(true)
  removedAt      DateTime?
  removalReason  String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft       Aircraft              @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  usageLogs      AircraftEngineUsageLog[]
  counterReadings CounterReading[]
  counterSlots    EquipmentCounterSlot[]

  // Nota: la unicidad real es "un solo motor ACTIVO por posición", impuesta
  // con un índice único parcial (WHERE "isActive" = true) en la migración
  // manual — Prisma no modela índices parciales, así que no hay @@unique aquí.
  @@index([organizationId, aircraftId])
  @@index([organizationId, serialNumber])
  @@map("aircraft_engines")
}

model AircraftEngineUsageLog {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  engineId       String                @db.Uuid
  hours          Decimal               @db.Decimal(10, 2)
  cycles         Int
  date           DateTime              @db.Date
  createdAt      DateTime              @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  engine         AircraftEngine        @relation(fields: [engineId], references: [id], onDelete: Cascade)

  @@index([organizationId, engineId, date])
  @@map("aircraft_engine_usage_logs")
}

/// Declaración de que un equipo de la lista DGAC aplica o no a una aeronave.
///
/// El informe deriva por sí solo los motores desde las posiciones N1/N2
/// registradas, y eso es preferible a una declaración porque no se puede quedar
/// desactualizado. Esta tabla es para lo que la plataforma NO modela —hélice y
/// APU—, donde el informe solo puede decir "no lo tengo registrado", que no es
/// lo mismo que "no corresponde".
///
/// Mismo patrón que la aplicabilidad de tareas en AircraftTask: decisión,
/// motivo, fecha y responsable, para que quede auditable quién lo determinó.
model AircraftEquipmentApplicability {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  aircraftId     String        @db.Uuid
  equipment      DgacEquipment

  applies        Boolean

  /// Justificación, p. ej. "Aeronave de ala rotatoria, sin hélice"
  notes          String?
  changedAt      DateTime      @default(now())
  changedById    String?       @db.Uuid

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft       Aircraft      @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  changedBy      User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([aircraftId, equipment])
  @@index([organizationId, aircraftId])
  @@map("aircraft_equipment_applicability")
}

  /// Alteración aprobada a la configuración de la aeronave (STC / Formulario DGAC 337)
model AircraftAlteration {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  aircraftId     String   @db.Uuid

  /// Documento que aprueba la alteración
  documentNumber String   @db.VarChar(255)
  description    String
  approvalDate   DateTime? @db.Date

  /// Suplemento del manual de vuelo asociado
  hasFlightManualSupplement Boolean @default(false)
  flightManualReference     String? @db.VarChar(255)

  /// Instrucciones de aeronavegabilidad continuada asociadas
  hasIca       Boolean  @default(false)
  icaReference String?  @db.VarChar(255)

  /// OT / taller donde se ejecutó
  reference    String?  @db.VarChar(255)
  notes        String?

  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft     Aircraft     @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// La unicidad real es (aircraftId, documentNumber, md5(description)): un mismo
  /// formulario puede amparar varias alteraciones. Se define como índice por
  /// expresión en la migración manual, que Prisma no puede representar.
  @@index([aircraftId])
  @@index([organizationId])
  @@map("aircraft_alterations")
}

/// Nota libre sobre una tarea en una aeronave: bitácora de revisión, sin
/// cumplimiento asociado. No altera vencimientos ni estado de la tarea.
model AircraftTaskNote {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  aircraftId     String   @db.Uuid
  taskId         String   @db.Uuid

  note           String

  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft     Aircraft        @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  task         MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([aircraftId, taskId, createdAt])
  @@index([organizationId])
  @@map("aircraft_task_notes")
}

/// Manual de referencia vigente por modelo (tabla DOC del Access).
model MaintenanceManual {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid

  model     String  @db.VarChar(120)
  /// Documento y revisión, tal como se cita en la OT
  reference String
  kind      String  @default("ENGINE") @db.VarChar(20)
  notes     String?

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("maintenance_manuals")
}

/// Taller aeronáutico habilitado (tabla CMA del Access).
model RepairShop {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid

  /// Código CMA de la autoridad; puede faltar en talleres extranjeros
  code     String? @db.VarChar(40)
  name     String  @db.VarChar(180)
  country  String? @db.VarChar(80)
  notes    String?
  isActive Boolean @default(true)

  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  contacts     RepairShopContact[]
  workOrders   WorkOrder[]
  workRequests WorkRequest[]

  @@index([organizationId])
  @@map("repair_shops")
}

/// Persona de contacto en un taller: a quién se le envía la ST.
model RepairShopContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  repairShopId   String   @db.Uuid

  name      String  @db.VarChar(180)
  role      String? @db.VarChar(120)
  email     String? @db.VarChar(255)
  phone     String? @db.VarChar(60)
  isPrimary Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  repairShop   RepairShop   @relation(fields: [repairShopId], references: [id], onDelete: Cascade)
  workRequests WorkRequest[]

  @@index([repairShopId, isActive])
  @@map("repair_shop_contacts")
}

/// Cambio de estado operacional de una aeronave, con su motivo y autor.
model AircraftStatusChange {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  aircraftId     String   @db.Uuid

  fromStatus AircraftStatus?
  toStatus   AircraftStatus
  reason     String

  changedById String?  @db.Uuid
  changedAt   DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft     Aircraft     @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  changedBy    User?        @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([aircraftId, changedAt])
  @@map("aircraft_status_changes")
}

/// Contador configurable (modelo de la tabla TN del Access): la organización
/// declara los que usa —CNG, CTL, LND, RIN…— en vez de tener dos fijos.
model CounterType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid

  code  String @db.VarChar(20)
  name  String @db.VarChar(120)
  unit  String @default("ciclos") @db.VarChar(30)
  scope String @default("BOTH") @db.VarChar(12)

  /// Contadores que ya existían como campo fijo; evita duplicar la verdad.
  legacyField String? @db.VarChar(30)
  /// Ranura del Access que representa (1 = LIMN1, 2 = LIMN2) para su alcance.
  /// Cambiar esto reinterpreta los límites sin volver a importar.
  slot        Int?    @db.SmallInt
  isActive    Boolean @default(true)
  sortOrder   Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  readings     CounterReading[]
  equipmentSlots EquipmentCounterSlot[]

  @@index([organizationId, isActive])
  @@map("counter_types")
}

/// Lectura de un contador para una aeronave o un motor.
model CounterReading {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  counterTypeId  String   @db.Uuid

  /// Exactamente uno de los dos
  aircraftId String? @db.Uuid
  engineId   String? @db.Uuid

  value       Decimal  @db.Decimal(12, 2)
  readingDate DateTime @db.Date
  source      String   @default("manual") @db.VarChar(30)
  notes       String?
  /// Folio correlativo de la bitácora física, asignado a mano por el operador.
  folio       String?  @db.VarChar(50)

  recordedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  counterType  CounterType     @relation(fields: [counterTypeId], references: [id], onDelete: Cascade)
  aircraft     Aircraft?       @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  engine       AircraftEngine? @relation(fields: [engineId], references: [id], onDelete: Cascade)
  recordedBy   User?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([aircraftId, counterTypeId, readingDate])
  @@index([engineId, counterTypeId, readingDate])
  @@map("counter_readings")
}

/// Límite de una tarea contra un contador. Una tarea puede tener varios: el
/// Access los guarda en dos ranuras cuyo contador depende del equipo.
model TaskCounterLimit {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  taskId         String @db.Uuid

  slot       Int     @db.SmallInt
  limitValue Decimal @db.Decimal(12, 2)
  /// Lectura del contador en el último cumplimiento
  lastValue  Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, slot])
  @@map("task_counter_limits")
}

/// Qué contador ocupa cada ranura en un equipo concreto. El Access lo declara
/// por equipo (EQ.TN1 / EQ.TN2) y varía entre aeronaves y entre motores.
model EquipmentCounterSlot {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid

  aircraftId String? @db.Uuid
  engineId   String? @db.Uuid

  slot          Int    @db.SmallInt
  counterTypeId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft     Aircraft?       @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  engine       AircraftEngine? @relation(fields: [engineId], references: [id], onDelete: Cascade)
  counterType  CounterType     @relation(fields: [counterTypeId], references: [id], onDelete: Cascade)

  @@map("equipment_counter_slots")
}

model AircraftUsageLog {
    id             String              @id @default(uuid()) @db.Uuid
    organizationId String              @db.Uuid
    aircraftId     String              @db.Uuid
    date           DateTime            @db.Date
    totalHours     Decimal             @db.Decimal(10, 2)
    totalCycles    Int
    source         AircraftUsageSource
    notes          String?
    createdAt      DateTime            @default(now())

    organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
    aircraft       Aircraft            @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

    @@index([organizationId, aircraftId, date])
    @@map("aircraft_usage_logs")
  }

model AircraftAssignedPlan {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  aircraftId     String               @db.Uuid
  category       AssignedPlanCategory
  templateId     String               @db.Uuid
  assignedById   String?              @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft       Aircraft             @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  template       MaintenanceTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  assignedBy     User?                @relation(fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([aircraftId, category, templateId])
  @@index([organizationId, aircraftId])
  @@index([templateId])
  @@map("aircraft_assigned_plans")
}
// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT  (EQ — Equipamiento con trazabilidad de número de serie)
// ─────────────────────────────────────────────────────────────────────────────

model Component {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid

  /// Currently installed on which aircraft (null = in store/shop)
  aircraftId     String?         @db.Uuid

  /// Part Number (P/N) — identifies the component type/design
  partNumber     String          @db.VarChar(100)

  /// Serial Number (S/N) — uniquely identifies this physical unit
  serialNumber   String          @db.VarChar(100)

  description    String          @db.VarChar(255)
  manufacturer   String          @db.VarChar(150)

  /// Where on the aircraft this is installed (e.g. "Engine 1 (CFM56-7B)", "LH MLG")
  position       String?         @db.VarChar(100)

  // ── Life tracking ──────────────────────────────────────────────────────────

  /// Total Accumulated Hours since new (used for TBO/life-limit checks)
  totalHoursSinceNew    Decimal  @default(0) @db.Decimal(10, 2)

  /// Total Accumulated Cycles since new
  totalCyclesSinceNew   Int      @default(0)

  /// Total Hours since last overhaul (resets at each shop visit)
  hoursSinceOverhaul    Decimal  @default(0) @db.Decimal(10, 2)

  /// Cycles since last overhaul
  cyclesSinceOverhaul   Int      @default(0)

  // ── TBO limits ─────────────────────────────────────────────────────────────

  /// Time Between Overhaul — hours limit (null = not applicable)
  tboHours       Decimal?        @db.Decimal(10, 2)

  /// Time Between Overhaul — cycles limit
  tboCycles      Int?

  /// Time Between Overhaul — calendar days limit
  tboCalendarDays Int?

  // ── Hard life limits (cannot be extended) ─────────────────────────────────

  lifeLimitHours  Decimal?       @db.Decimal(10, 2)
  lifeLimitCycles Int?

  // ── Installation data (populated when component is fitted) ─────────────────

  installationDate    DateTime?  @db.Date
  /// Aircraft hours at the time of installation (for interval tracking)
  installationAircraftHours Decimal? @db.Decimal(10, 2)
  installationAircraftCycles Int?

  status         ComponentStatus @default(SERVICEABLE)
  isActive       Boolean         @default(true)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft       Aircraft?       @relation(fields: [aircraftId], references: [id])

  /// M:N — which maintenance tasks apply to this component
  applicableTasks ComponentTask[]
  compliances     Compliance[]
  history         ComponentHistory[]
  workRequestItems WorkRequestItem[]
  componentInstances ComponentInstance[]

  @@unique([serialNumber, organizationId])
  @@index([organizationId])
  @@index([aircraftId])
  @@index([partNumber, organizationId])
  @@index([status, organizationId])
  @@map("components")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MAINTENANCE TASK  (Task Definition / Card)
//  Represents the DEFINITION of an inspection, overhaul, replacement, etc.
//  Actual execution is recorded in Compliance.
// ─────────────────────────────────────────────────────────────────────────────

model MaintenanceTask {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid

  /// Human-readable task code (e.g. "50H-INSP", "A-CHECK", "AD-2024-15-01")
  code           String          @db.VarChar(100)

  /// ATA chapter (e.g. "05-10-01"). Nullable — most historical/imported tasks
  /// don't have it filled in yet.
  ata            String?         @db.VarChar(20)

  /// Célula de la aeronave vs motor: separa los controles que en Access viven en
  /// las vistas COMP (motor) y COMP1 (aeronave).
  equipmentScope EquipmentScope  @default(AIRCRAFT)

  /// Recurrencia declarada en el origen: separa las AD repetitivas de las de
  /// cumplimiento único.
  complianceRecurrence ComplianceRecurrence @default(UNSPECIFIED)

  title          String          @db.VarChar(255)
  description    String

  intervalType   TaskIntervalType

  // ── Recurrence intervals (set the applicable ones based on intervalType) ───

  /// Primary interval in flight hours (e.g. 100.00)
  intervalHours  Decimal?        @db.Decimal(10, 2)

  /// Primary interval in cycles/landings
  intervalCycles Int?

  /// Primary interval in calendar days (e.g. 365 for annual)
  intervalCalendarDays Int?

  /// Primary interval in calendar months (e.g. 6 for semestral)
  intervalCalendarMonths Int?

  // ── Tolerances (grace period before task becomes overdue) ──────────────────

  toleranceHours       Decimal?  @db.Decimal(8, 2)
  toleranceCycles      Int?
  toleranceCalendarDays Int?

  // ── Regulatory/technical reference ────────────────────────────────────────

  /// Reference identifier (AD number, AMM chapter/section, SB number)
  referenceNumber String?        @db.VarChar(100)
  referenceType   ReferenceType  @default(AMM)

  /// True = regulatory mandatory (AD, CMR). False = manufacturer/operator rec.
  isMandatory     Boolean        @default(false)

  /// Estimated man-hours to perform the task
  estimatedManHours Decimal?     @db.Decimal(6, 2)

  /// Whether an independent inspection (RII) is required after this task
  requiresInspection Boolean     @default(false)
  /// Control de vida de un componente (dominio COMP del Access). Se gestiona
  /// en la página de Componentes; el plan lo excluye salvo que se pida.
  isComponentControl Boolean  @default(false)

  /// Specific aircraft model this task applies to (null = all models)
  applicableModel String?        @db.VarChar(150)

  /// Specific part number this task applies to (null = aircraft-level task)
  applicablePartNumber String?   @db.VarChar(100)

  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// M:N — aircraft that have this task assigned
  aircraftLinks   AircraftTask[]

  /// M:N — components that have this task assigned
  componentLinks  ComponentTask[]

  compliances     Compliance[]
  workOrderTasks  WorkOrderTask[]
  workRequestItems WorkRequestItem[]
  componentApplications ComponentApplication[]
  taskNotes       AircraftTaskNote[]
  counterLimits   TaskCounterLimit[]

  @@unique([code, organizationId])
  @@index([organizationId])
  @@index([isMandatory, organizationId])
  @@index([referenceType, organizationId])
  @@map("maintenance_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
//  AIRCRAFT TASK  (M:N join — aircraft ↔ maintenance tasks)
// ─────────────────────────────────────────────────────────────────────────────

model AircraftTask {
  id         String   @id @default(uuid()) @db.Uuid

  aircraftId String   @db.Uuid
  taskId     String   @db.Uuid

  /// Override interval at aircraft level (e.g. operator escalation approved by authority)
  overrideIntervalHours  Decimal? @db.Decimal(10, 2)
  overrideIntervalCycles Int?

  /// isActive=false significa "no aplica a esta aeronave". El vínculo se conserva
  /// siempre: la no aplicabilidad puede revertirse (p. ej. una tarea descartada por
  /// ambiente salino vuelve a aplicar si la aeronave cambia de base).
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  /// Justificación de la última decisión de aplicabilidad
  applicabilityNotes       String?
  applicabilityChangedAt   DateTime?
  applicabilityChangedById String?  @db.Uuid

  aircraft   Aircraft        @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  task       MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  applicabilityChangedBy User? @relation("AircraftTaskApplicability", fields: [applicabilityChangedById], references: [id], onDelete: SetNull)

  @@unique([aircraftId, taskId])
  @@index([aircraftId])
  @@index([taskId])
  @@map("aircraft_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT TASK  (M:N join — component ↔ maintenance tasks)
// ─────────────────────────────────────────────────────────────────────────────

model ComponentTask {
  id          String   @id @default(uuid()) @db.Uuid

  componentId String   @db.Uuid
  taskId      String   @db.Uuid

  isActive    Boolean  @default(true)
  assignedAt  DateTime @default(now())

  component   Component       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  task        MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([componentId, taskId])
  @@index([componentId])
  @@index([taskId])
  @@map("component_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPLIANCE  (Cumplimiento — historical record of task execution)
//  This is the audit core. Once written, records must be immutable.
// ─────────────────────────────────────────────────────────────────────────────

model Compliance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid

  /// The aircraft this compliance record belongs to
  aircraftId     String           @db.Uuid

  /// The task definition that was performed
  taskId         String           @db.Uuid

  /// The component this compliance applies to (null = airframe-level task)
  componentId    String?          @db.Uuid

  /// Technician who performed the work
  performedById  String           @db.Uuid

  /// Inspector who independently verified the work (RII sign-off, null if not required)
  inspectedById  String?          @db.Uuid

  // ── When it was done ───────────────────────────────────────────────────────

  performedAt           DateTime
  /// Aircraft total hours at time of compliance
  aircraftHoursAtCompliance  Decimal   @db.Decimal(10, 2)
  /// Aircraft total cycles at time of compliance
  aircraftCyclesAtCompliance Int

  // ── Next due values (pre-calculated at record time) ───────────────────────
  //  These are IMMUTABLE after creation — next cycle recalculates from new compliance

  nextDueHours          Decimal?   @db.Decimal(10, 2)
  nextDueCycles         Int?
  nextDueDate           DateTime?  @db.Date

  // ── Work order reference ──────────────────────────────────────────────────

  /// Internal work order number linking to the maintenance package
  workOrderNumber String?          @db.VarChar(50)

  /// Classification of this record in lifecycle semantics
  applicationType ComplianceApplicationType @default(application)
  /// True when this is the initial baseline/control-start record
  isInitial      Boolean           @default(false)

  status         ComplianceStatus  @default(COMPLETED)

  /// If deferred: MEL/NEF item reference and expiry
  deferralReference String?        @db.VarChar(100)
  deferralExpiresAt DateTime?

  notes          String?
  createdAt      DateTime          @default(now())

  // ── No updatedAt — compliance records should be append-only ──────────────

  // Relations
  organization   Organization      @relation(fields: [organizationId], references: [id])
  aircraft       Aircraft          @relation(fields: [aircraftId], references: [id])
  task           MaintenanceTask   @relation(fields: [taskId], references: [id])
  component      Component?        @relation(fields: [componentId], references: [id])
  performedBy    User              @relation("PerformedBy", fields: [performedById], references: [id])
  inspectedBy    User?             @relation("InspectedBy", fields: [inspectedById], references: [id])

  // ── Indexes for the two most critical queries ─────────────────────────────
  // 1. "What is the current due-status for each task on this aircraft?"
  @@index([aircraftId, taskId])
  // 2. "What tasks are overdue / coming due across the fleet?"
  @@index([nextDueHours, organizationId])
  @@index([nextDueDate, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, applicationType])
  @@index([componentId])
  @@map("compliances")
}

// ─────────────────────────────────────────────────────────────────────────────
//  WORK ORDER  (Orden de Trabajo / OT)
//  Central work package. State machine: DRAFT→OPEN→IN_PROGRESS→QUALITY→CLOSED
// ─────────────────────────────────────────────────────────────────────────────

model WorkOrder {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid

  /// Sequential WO number scoped to org (e.g. OT-2024-001)
  number         String          @db.VarChar(50)

  aircraftId     String          @db.Uuid
  title          String          @db.VarChar(255)
  description    String?

  status         WorkOrderStatus @default(DRAFT)

  /// User who opened/created this WO
  createdById    String          @db.Uuid

  /// Technician(s) assigned to execute the work
  assignedTechnicianId String?   @db.Uuid

  /// Inspector responsible for quality/close sign-off (must have INSPECTOR role)
  inspectorId    String?         @db.Uuid

  // ── Scheduling ────────────────────────────────────────────────────────────
  plannedStartDate DateTime?     @db.Date
  plannedEndDate   DateTime?     @db.Date
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  // ── Assignment workflow ────────────────────────────────────────────────────
  /// Tracks assignment status separately from main WorkOrderStatus
  assignmentStatus WorkOrderAssignmentStatus @default(PENDING)

  /// Timestamp when technician was assigned
  assignedAt          DateTime?

  // ── Evidencia y cierre ─────────────────────────────────────────────────────
  /// File URL for evidence (photo, signed PDF) — stored in S3/bucket
  evidenceFileUrl     String?    @db.VarChar(500)

  /// Original filename of evidence
  evidenceFileName    String?    @db.VarChar(255)

  /// When evidence was uploaded
  evidenceUploadedAt  DateTime?

  /// Who uploaded the evidence (usually the technician)
  evidenceUploadedBy  String?    @db.Uuid

  /// Type of evidence file
  evidenceType        WorkOrderEvidenceType?

  // ── Aircraft state snapshot at open/close ─────────────────────────────────
  aircraftHoursAtOpen    Decimal?   @db.Decimal(10, 2)
  aircraftCyclesAtOpen   Int?
  aircraftHoursAtClose   Decimal?   @db.Decimal(10, 2)
  aircraftCyclesAtClose  Int?

  /// User who performed the final close sign-off (must have INSPECTOR role)
  closedById     String?         @db.Uuid
  closedAt       DateTime?

  /// Taller que ejecutó el trabajo
  repairShopId   String?         @db.Uuid
  /// Manuales citados al cerrar; el Access los guarda como texto libre
  aircraftManualRef String?      @db.VarChar(255)
  engineManualRef   String?      @db.VarChar(255)
  /// Certificado de retorno al servicio
  releaseToServiceNote String?

  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft             Aircraft        @relation(fields: [aircraftId], references: [id])
  createdBy            User            @relation("WOCreatedBy",    fields: [createdById],            references: [id])
  assignedTechnician   User?           @relation("WOAssignedTechnician", fields: [assignedTechnicianId], references: [id])
  inspector            User?           @relation("WOInspector",    fields: [inspectorId],            references: [id])
  evidenceUploadedByUser User?         @relation("WOEvidenceUploadedBy", fields: [evidenceUploadedBy], references: [id])
  closedBy             User?           @relation("WOClosedBy",     fields: [closedById],             references: [id])
  repairShop           RepairShop?     @relation(fields: [repairShopId], references: [id], onDelete: SetNull)

  tasks                WorkOrderTask[]
  discrepancies        Discrepancy[]
  componentMovements   ComponentHistory[]
  auditLogs            AuditLog[]

  @@unique([number, organizationId])
  @@index([organizationId])
  @@index([aircraftId])
  @@index([status, organizationId])
  @@index([assignmentStatus])
  @@index([assignedTechnicianId])
  @@index([createdById])
  @@map("work_orders")
}

// ─────────────────────────────────────────────────────────────────────────────
//  WORK ORDER TASK  (Task line-items within a WO)
// ─────────────────────────────────────────────────────────────────────────────

model WorkOrderTask {
  id             String   @id @default(uuid()) @db.Uuid
  workOrderId    String   @db.Uuid
  taskId         String   @db.Uuid

  /// Whether the technician has completed and signed off this task
  isCompleted    Boolean  @default(false)
  completedAt    DateTime?
  completedById  String?  @db.Uuid
  notes          String?

  workOrder      WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  task           MaintenanceTask @relation(fields: [taskId],      references: [id])
  completedBy    User?           @relation("WOTaskCompletedBy",  fields: [completedById], references: [id])

  @@unique([workOrderId, taskId])
  @@index([workOrderId])
  @@index([taskId])
  @@map("work_order_tasks")
}

// ─────────────────────────────────────────────────────────────────────────────
//  WORK REQUEST  (Solicitud de Trabajo / ST)
//  Editable container that can group multiple maintenance tasks before dispatch
// ─────────────────────────────────────────────────────────────────────────────

model WorkRequest {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  aircraftId     String            @db.Uuid

  /// Sequential ST number scoped to org (e.g. ST-2026-0001)
  number         String            @db.VarChar(50)

  status         WorkRequestStatus @default(DRAFT)

  /// User who created/assembled the request
  createdById    String            @db.Uuid

  /// Responsible user in CMA / Oficina Tecnica
  responsibleId  String?           @db.Uuid

  /// Snapshot values captured at ST creation
  aircraftHoursAtRequest Decimal?  @db.Decimal(10, 2)
  aircraftCyclesN1       Int?
  aircraftCyclesN2       Int?

  /// Revisión previa al envío
  reviewerId     String?           @db.Uuid
  reviewedAt     DateTime?
  reviewNotes    String?

  /// Destino: taller y persona a quien se envió, y por qué vía
  repairShopId        String?      @db.Uuid
  repairShopContactId String?      @db.Uuid
  /// EMAIL cuando se envía con el PDF adjunto; MANUAL cuando se imprime y entrega
  dispatchMethod      String?      @db.VarChar(20)
  dispatchNotes       String?

  /// OT que devuelve el taller
  otNumber         String?         @db.VarChar(80)
  otReceivedAt     DateTime?
  otDocumentUrl    String?
  otRegisteredById String?         @db.Uuid

  closedAt       DateTime?
  closedById     String?           @db.Uuid

  /// Envío efectivo del correo: distinto de dispatchMethod, que solo dice cómo
  /// se decidió enviarla. Vacío significa que el correo no llegó a salir.
  emailSentAt    DateTime?
  emailSentTo    String?           @db.VarChar(255)

  /// Aviso por WhatsApp al contacto del taller
  whatsappSentAt DateTime?
  whatsappSentTo String?           @db.VarChar(40)

  /// Dispatch tracking
  sentAt         DateTime?
  sentById       String?           @db.Uuid

  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft       Aircraft          @relation(fields: [aircraftId], references: [id])
  createdBy      User              @relation("WRCreatedBy", fields: [createdById], references: [id])
  responsible    User?             @relation("WRResponsible", fields: [responsibleId], references: [id])
  sentBy         User?             @relation("WRSentBy", fields: [sentById], references: [id])
  reviewer       User?             @relation("WRReviewer", fields: [reviewerId], references: [id])
  otRegisteredBy User?             @relation("WROtRegisteredBy", fields: [otRegisteredById], references: [id])
  closedBy       User?             @relation("WRClosedBy", fields: [closedById], references: [id])
  repairShop     RepairShop?       @relation(fields: [repairShopId], references: [id], onDelete: SetNull)
  repairShopContact RepairShopContact? @relation(fields: [repairShopContactId], references: [id], onDelete: SetNull)

  items          WorkRequestItem[]
  componentApplications ComponentApplication[]
  componentMovements ComponentMovement[]

  @@unique([number, organizationId])
  @@index([organizationId, status])
  @@index([aircraftId, status])
  @@index([responsibleId])
  @@map("work_requests")
}

/// Join table for WorkRequest <-> MaintenanceTask (M:N)
model WorkRequestItem {
  id            String          @id @default(uuid()) @db.Uuid
  workRequestId String          @db.Uuid
  taskId        String?         @db.Uuid
  componentId   String?         @db.Uuid
  discrepancyId String?         @db.Uuid

  sourceKind    WorkRequestItemSourceKind @default(maintenance_plan)
  sourceId      String          @db.VarChar(100)
  executionType WorkRequestItemExecutionType?
  requiresComponentTracking Boolean @default(false)
  componentDefinitionId String? @db.Uuid

  category      WorkRequestItemCategory @default(MAINTENANCE_PLAN)
  itemCode      String?         @db.VarChar(100)
  itemTitle     String          @db.VarChar(255)
  itemDescription String?

  /// Why this task was added (AUTO threshold / manual grouping)
  source        String          @default("AUTO") @db.VarChar(20)
  addedAt       DateTime        @default(now())

  workRequest   WorkRequest     @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  task          MaintenanceTask? @relation(fields: [taskId], references: [id])
  component     Component?      @relation(fields: [componentId], references: [id])
  discrepancy   Discrepancy?    @relation(fields: [discrepancyId], references: [id])

  /// Una tarea no puede repetirse dentro de la misma solicitud. Es índice
  /// parcial (solo taskId no nulo), definido en la migración manual porque
  /// Prisma no expresa índices únicos con condición.
  @@index([workRequestId, category])
  @@index([sourceKind, sourceId])
  @@index([executionType])
  @@index([componentDefinitionId])
  @@index([taskId])
  @@index([componentId])
  @@index([discrepancyId])
  @@map("work_request_items")
}

model ComponentDefinition {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  ataChapter     String                @db.VarChar(20)
  ataCode        String                @db.VarChar(50)
  name           String                @db.VarChar(255)
  description    String
  executionType  ComponentExecutionType
  intervalType   ComponentIntervalType
  intervalHours  Decimal?              @db.Decimal(10, 2)
  intervalCycles Int?
  intervalDays   Int?
  requiresComponentTracking Boolean    @default(false)
  sourceGroup    String                @db.VarChar(100)
  reference      String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instances      ComponentInstance[]
  applications   ComponentApplication[]

  @@index([organizationId])
  @@index([organizationId, ataCode])
  @@map("component_definitions")
}

model ComponentInstance {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  definitionId   String                  @db.Uuid
  aircraftId     String?                 @db.Uuid
  legacyComponentId String?              @db.Uuid
  partNumber     String                  @db.VarChar(100)
  serialNumber   String                  @db.VarChar(100)
  position       String                  @db.VarChar(150)
  status         ComponentInstanceStatus @default(spare)
  installedAt    DateTime?
  removedAt      DateTime?
  installedAtHours Decimal?              @db.Decimal(10, 2)
  removedAtHours Decimal?                @db.Decimal(10, 2)
  installedAtCycles Int?
  removedAtCycles Int?
  installWorkOrderNumber String?         @db.VarChar(50)
  removalWorkOrderNumber String?         @db.VarChar(50)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition     ComponentDefinition     @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  aircraft       Aircraft?               @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  legacyComponent Component?             @relation(fields: [legacyComponentId], references: [id], onDelete: SetNull)
  applications   ComponentApplication[]
  removedMovements ComponentMovement[]   @relation("ComponentMovementRemoved")
  installedMovements ComponentMovement[] @relation("ComponentMovementInstalled")

  @@unique([serialNumber, organizationId])
  @@index([organizationId])
  @@index([aircraftId])
  @@index([definitionId])
  @@index([legacyComponentId])
  @@map("component_instances")
}

model ComponentApplication {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  definitionId   String                    @db.Uuid
  componentInstanceId String?              @db.Uuid
  aircraftId     String                    @db.Uuid
  taskId         String?                   @db.Uuid
  workRequestId  String?                   @db.Uuid
  officeOrderId  String?                   @db.VarChar(100)
  workOrderNumber String?                  @db.VarChar(50)
  appliedAt      DateTime
  aircraftHoursAtApplication Decimal        @db.Decimal(10, 2)
  aircraftCyclesAtApplication Int
  nextDueHours   Decimal?                  @db.Decimal(10, 2)
  nextDueCycles  Int?
  nextDueDate    DateTime?                 @db.Date
  applicationType ComplianceApplicationType @default(application)
  isInitial      Boolean                   @default(false)
  notes          String?
  createdAt      DateTime                  @default(now())

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition     ComponentDefinition       @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  componentInstance ComponentInstance?     @relation(fields: [componentInstanceId], references: [id], onDelete: SetNull)
  aircraft       Aircraft                  @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  task           MaintenanceTask?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workRequest    WorkRequest?              @relation(fields: [workRequestId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([aircraftId])
  @@index([definitionId])
  @@index([componentInstanceId])
  @@index([workRequestId])
  @@map("component_applications")
}

model ComponentMovement {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  aircraftId     String                    @db.Uuid
  position       String                    @db.VarChar(150)
  movementType   ComponentMovementKind
  removedComponentInstanceId String?       @db.Uuid
  installedComponentInstanceId String?     @db.Uuid
  workRequestId  String?                   @db.Uuid
  officeOrderId  String?                   @db.VarChar(100)
  workOrderNumber String?                  @db.VarChar(50)
  performedAt    DateTime
  aircraftHoursAtMovement Decimal           @db.Decimal(10, 2)
  aircraftCyclesAtMovement Int
  notes          String?
  performedById  String                    @db.Uuid
  createdAt      DateTime                  @default(now())

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraft       Aircraft                  @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  removedComponentInstance ComponentInstance? @relation("ComponentMovementRemoved", fields: [removedComponentInstanceId], references: [id], onDelete: SetNull)
  installedComponentInstance ComponentInstance? @relation("ComponentMovementInstalled", fields: [installedComponentInstanceId], references: [id], onDelete: SetNull)
  workRequest    WorkRequest?              @relation(fields: [workRequestId], references: [id], onDelete: SetNull)
  performedBy    User                      @relation("ComponentTrackingMovedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([aircraftId])
  @@index([workRequestId])
  @@index([removedComponentInstanceId])
  @@index([installedComponentInstanceId])
  @@map("component_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
//  DISCREPANCY  (Hallazgo / Discrepancia within a WO)
//  Non-routine findings raised during execution. May be deferred via MEL/CDL.
// ─────────────────────────────────────────────────────────────────────────────

model Discrepancy {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  workOrderId    String            @db.Uuid

  /// Auto-generated sequential code: DC-{YEAR}-{SEQ} scoped to org
  code           String            @db.VarChar(50)

  title          String            @db.VarChar(255)
  description    String

  /// Physical location on aircraft (e.g. "LH flap track 3", "Frame 23")
  location       String?           @db.VarChar(150)

  /// Criticality / ATA chapter reference
  ataChapter     String?           @db.VarChar(20)

  status         DiscrepancyStatus @default(OPEN)

  foundById      String            @db.Uuid
  resolvedById   String?           @db.Uuid
  resolvedAt     DateTime?
  resolutionNotes String?

  /// MEL/CDL deferral reference and expiry (if DEFERRED)
  deferralRef    String?           @db.VarChar(100)
  deferralExpiresAt DateTime?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  organization   Organization      @relation(fields: [organizationId], references: [id])
  workOrder      WorkOrder         @relation(fields: [workOrderId],    references: [id], onDelete: Cascade)
  foundBy        User              @relation("DiscrepancyFoundBy",     fields: [foundById],     references: [id])
  resolvedBy     User?             @relation("DiscrepancyResolvedBy",  fields: [resolvedById],  references: [id])
  workRequestItems WorkRequestItem[]

  @@index([workOrderId])
  @@index([organizationId, status])
  @@map("discrepancies")
}

// ─────────────────────────────────────────────────────────────────────────────
//  AUDIT LOG  (Trazabilidad — IMMUTABLE append-only log for DGAC compliance)
//  Never update or delete rows. Foreign keys are intentionally left as strings
//  so logs survive referenced entity deletion.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid

  /// Entity type that changed (e.g. "WorkOrder", "Discrepancy", "Compliance")
  entityType     String   @db.VarChar(50)

  /// UUID of the changed entity
  entityId       String   @db.Uuid

  /// Human-readable action label (e.g. "STATUS_CHANGED", "TASK_COMPLETED", "DISCREPANCY_CREATED")
  action         String   @db.VarChar(100)

  /// Snapshot of the relevant field(s) before the change
  previousValue  Json?

  /// Snapshot of the relevant field(s) after the change
  newValue       Json?

  /// User who caused the change
  userId         String   @db.Uuid
  userEmail      String   @db.VarChar(255)
  userRole       String   @db.VarChar(50)

  /// Optional metadata (IP, user-agent, notes)
  metadata       Json?

  /// ── No updatedAt — this table is append-only ──
  createdAt      DateTime @default(now())

  // Optional relation to WorkOrder for quick lookups (nullable — log survives WO deletion)
  workOrderId    String?  @db.Uuid
  workOrder      WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([userId])
  @@index([workOrderId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
//  COMPONENT HISTORY  (Historial de instalación/remoción de componentes)
//  Append-only. One row per installation, one row per removal.
// ─────────────────────────────────────────────────────────────────────────────

model ComponentHistory {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid

  componentId    String               @db.Uuid
  aircraftId     String               @db.Uuid

  movementType   ComponentMovementType

  // ── Aircraft state at time of movement ────────────────────────────────────
  aircraftHoursAtMovement   Decimal   @db.Decimal(10, 2)
  aircraftCyclesAtMovement  Int

  // ── Component accumulated state at time of movement ───────────────────────
  componentHoursAtMovement  Decimal   @db.Decimal(10, 2)
  componentCyclesAtMovement Int

  /// Position on aircraft (e.g. "Engine 1", "LH MLG", "Nose Gear")
  position       String?              @db.VarChar(150)

  /// Work order that authorized this movement (optional)
  workOrderId    String?              @db.Uuid

  performedById  String               @db.Uuid
  notes          String?

  movedAt        DateTime

  /// ── No updatedAt — this table is append-only ──
  createdAt      DateTime             @default(now())

  // Relations
  component      Component            @relation(fields: [componentId], references: [id])
  aircraft       Aircraft             @relation(fields: [aircraftId],  references: [id])
  workOrder      WorkOrder?           @relation(fields: [workOrderId], references: [id])
  performedBy    User                 @relation("ComponentMovedBy",    fields: [performedById], references: [id])

  @@index([componentId])
  @@index([aircraftId])
  @@index([organizationId])
  @@index([workOrderId])
  @@map("component_history")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MAINTENANCE TEMPLATE  (Biblioteca Maestra de Mantenimiento)
//  Almacena planes estándar por Fabricante/Modelo para reutilizar en nuevas aeronaves
// ─────────────────────────────────────────────────────────────────────────────

model MaintenanceTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid

  /// Aircraft manufacturer (e.g. "Airbus", "Boeing", "Beechcraft")
  manufacturer   String   @db.VarChar(150)

  /// Aircraft model (e.g. "AS350 B3", "737-800", "Twin Otter")
  model          String   @db.VarChar(150)

  /// Human-readable description of this template
  description    String?

  /// Version number for tracking changes (e.g. "1.0", "2.1")
  version        String   @default("1.0") @db.VarChar(20)

  /// Template is available for use when creating new aircraft
  isActive       Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks          MaintenanceTemplateTask[]
  assignedPlans  AircraftAssignedPlan[]

  @@unique([manufacturer, model, organizationId])
  @@index([organizationId])
  @@index([manufacturer])
  @@index([model])
  @@map("maintenance_templates")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MAINTENANCE TEMPLATE TASK  (Tareas que forman parte de una plantilla)
// ─────────────────────────────────────────────────────────────────────────────

model MaintenanceTemplateTask {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @db.Uuid

  /// Task code — human-readable identifier (e.g. "50H-INSP", "04-10-00", "AD-2024-15")
  code       String   @db.VarChar(100)

  /// Short title of the task
  title      String   @db.VarChar(255)

  /// Detailed description of the task
  description String

  /// AMM/SB chapter classification (e.g. "04-10-00" for Airbus, "32-51-00" for engines)
  chapter    String?  @db.VarChar(20)

  /// Section/category within chapter (e.g. "ALS", "MSM", "ECS")
  section    String?  @db.VarChar(50)

  // ── Interval configuration ─────────────────────────────────────────────────

  /// Type of interval control (hours, cycles, calendar, or combination)
  intervalType       TaskIntervalType

  /// Interval in flight hours (nullable if not applicable)
  intervalHours      Decimal?        @db.Decimal(10, 2)

  /// Interval in cycles/landings
  intervalCycles     Int?

  /// Interval in calendar days
  intervalCalendarDays Int?

  /// Interval in calendar months
  intervalCalendarMonths Int?

  // ── Regulatory/Reference info ──────────────────────────────────────────────

  /// Reference number (AD#, SB#, etc.)
  referenceNumber String?        @db.VarChar(100)

  /// Type of reference (AMM, AD, SB, etc.)
  referenceType   ReferenceType  @default(AMM)

  /// True if regulatory mandatory
  isMandatory     Boolean        @default(false)

  /// Estimated man-hours to perform
  estimatedManHours Decimal?     @db.Decimal(6, 2)

  /// True if independent inspection (RII) required after task
  requiresInspection Boolean     @default(false)

  /// Specific aircraft model applicability (inherited from template)
  applicableModel String?        @db.VarChar(150)

  /// Specific part number applicability
  applicablePartNumber String?   @db.VarChar(100)

  // Metadata
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  template       MaintenanceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([templateId])
  @@index([chapter])
  @@map("maintenance_template_tasks")
}
